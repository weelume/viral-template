{
  "name": "viral-site-reference",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "scripts": {
    "dev": "node scripts/next.mjs dev",
    "build": "node scripts/next.mjs build",
    "start": "node scripts/next.mjs start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "capture": "node scripts/capture-viral.mjs",
    "test": "node --test tests/*.test.mjs",
    "verify": "pnpm lint && pnpm build && pnpm typecheck && pnpm test && pnpm capture",
    "tpl:check": "node .tpl/tools/check.mjs ."
  },
  "dependencies": {
    "framer-motion": "^12.38.0",
    "next": "^15.3.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^15.3.3",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.4.0",
    "typescript": "~6.0.2",
    "@tailwindcss/postcss": "^4.2.2",
    "tailwindcss": "^4.2.2",
    "typescript-eslint": "^8.58.0"
  }
}
