{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Viral 本地运行环境",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "PORT": {
      "type": "string",
      "description": "仅监听 127.0.0.1 的页面服务端口，必须在 1–65535。",
      "x-secret": false,
      "x-exposure": "server",
      "pattern": "^[0-9]{1,5}$",
      "default": "43120"
    },
    "NEXT_TELEMETRY_DISABLED": {
      "type": "string",
      "description": "Next.js 遥测保持关闭。",
      "x-secret": false,
      "x-exposure": "server",
      "const": "1",
      "default": "1"
    },
    "CHROME_PATH": {
      "type": "string",
      "description": "可选：浏览器验收使用的本地 Chrome/Chromium 可执行文件；未设置时探测常见安装路径。",
      "x-secret": false,
      "x-exposure": "server"
    }
  },
  "required": []
}
