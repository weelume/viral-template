{
  "$schema": "./schemas/project.schema.json",
  "format": "git-template-project",
  "formatVersion": "0.2.0",
  "stage": "ready",
  "toolchain": {
    "runtime": "node",
    "runtimeVersionFile": ".nvmrc",
    "packageManager": "pnpm",
    "packageManagerSource": "package.json",
    "lockfile": "pnpm-lock.yaml"
  },
  "environment": {
    "schema": ".tpl/contracts/env.schema.json",
    "example": ".env.example"
  },
  "operations": {
    "install": {
      "cwd": ".",
      "argv": [
        "pnpm",
        "install",
        "--frozen-lockfile"
      ],
      "dependsOn": [],
      "timeoutSeconds": 300,
      "requiredEnv": [],
      "effects": {
        "network": true,
        "persistentData": false
      },
      "requiresTools": [
        "node",
        "pnpm"
      ]
    },
    "lint": {
      "cwd": ".",
      "argv": [
        "pnpm",
        "run",
        "lint"
      ],
      "dependsOn": [],
      "timeoutSeconds": 300,
      "requiredEnv": [],
      "effects": {
        "network": false,
        "persistentData": false
      },
      "requiresTools": [
        "node",
        "pnpm"
      ]
    },
    "typecheck": {
      "cwd": ".",
      "argv": [
        "pnpm",
        "run",
        "typecheck"
      ],
      "dependsOn": [
        "build"
      ],
      "timeoutSeconds": 300,
      "requiredEnv": [],
      "effects": {
        "network": false,
        "persistentData": false
      },
      "requiresTools": [
        "node",
        "pnpm"
      ]
    },
    "test": {
      "cwd": ".",
      "argv": [
        "pnpm",
        "run",
        "test"
      ],
      "dependsOn": [],
      "timeoutSeconds": 300,
      "requiredEnv": [],
      "effects": {
        "network": false,
        "persistentData": false
      },
      "requiresTools": [
        "node",
        "pnpm"
      ]
    },
    "build": {
      "cwd": ".",
      "argv": [
        "pnpm",
        "run",
        "build"
      ],
      "dependsOn": [],
      "timeoutSeconds": 300,
      "requiredEnv": [],
      "effects": {
        "network": false,
        "persistentData": false
      },
      "requiresTools": [
        "node",
        "pnpm"
      ]
    },
    "capture": {
      "cwd": ".",
      "argv": [
        "pnpm",
        "run",
        "capture"
      ],
      "dependsOn": [
        "build"
      ],
      "timeoutSeconds": 300,
      "requiredEnv": [],
      "effects": {
        "network": false,
        "persistentData": false
      },
      "requiresTools": [
        "node",
        "pnpm",
        "browser"
      ]
    },
    "verify": {
      "cwd": ".",
      "argv": [
        "pnpm",
        "run",
        "verify"
      ],
      "dependsOn": [],
      "timeoutSeconds": 600,
      "requiredEnv": [],
      "effects": {
        "network": false,
        "persistentData": false
      },
      "requiresTools": [
        "node",
        "pnpm",
        "browser"
      ]
    }
  },
  "services": {
    "web": {
      "cwd": ".",
      "argv": [
        "node",
        "scripts/next.mjs",
        "start"
      ],
      "dependsOn": [],
      "prepareOperations": [
        "build"
      ],
      "requiredEnv": [],
      "effects": {
        "network": false,
        "persistentData": false
      },
      "port": {
        "env": "PORT",
        "default": 43120
      },
      "ready": {
        "kind": "http",
        "path": "/templates/viral/site",
        "status": 200,
        "timeoutSeconds": 60
      },
      "requiresTools": [
        "node"
      ]
    }
  },
  "checks": [
    "install",
    "lint",
    "typecheck",
    "test",
    "build",
    "capture"
  ],
  "customization": ".tpl/customization.json",
  "requirements": {
    "browser": {
      "kind": "browser",
      "pathEnv": "CHROME_PATH",
      "instructions": "安装本机 Chrome/Chromium 或用 CHROME_PATH 指向可执行文件。仅 capture/verify 需要；安装、构建及页面服务不依赖浏览器。"
    }
  },
  "previews": [
    {
      "surfaceId": "site",
      "service": "web",
      "localePaths": {
        "zh": "/templates/viral/site",
        "en": "/templates/viral/site/en"
      }
    }
  ]
}
